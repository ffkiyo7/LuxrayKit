{
  "name": "pokemon-champions-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial mobile-first PWA companion for Pokémon Champions.",
  "license": "MIT",
  "homepage": "https://luxraykit.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ffkiyo7/LuxrayKit.git"
  },
  "bugs": {
    "url": "https://github.com/ffkiyo7/LuxrayKit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:pwa": "playwright test --project=chrome-mobile-390",
    "test:visual": "bash scripts/visual-docker.sh",
    "test:visual:update": "bash scripts/visual-docker.sh --update-snapshots",
    "//data:regma:allowlist": "DANGER (M-A historical): rewrites allowlist.ts wholesale from the M-A-era official endpoint. Rows for later regulations are hand-authored and would be deleted; the script now refuses to run while any non-'reg-ma-' row exists. Add new-regulation rows by hand.",
    "data:regma:allowlist": "node scripts/generate-regma-allowlist.mjs",
    "data:regma:abilities": "node scripts/generate-ability-effects.mjs",
    "data:regma:abilities:check": "node scripts/generate-ability-effects.mjs --check",
    "data:regma:catalog-batch": "node scripts/generate-catalog-batch.mjs",
    "data:regma:catalog-batch:list": "node scripts/generate-catalog-batch.mjs --list",
    "data:regma:moves": "node scripts/generate-champions-moves.mjs",
    "data:items:audit": "node scripts/audit-item-catalog.mjs",
    "data:items:refresh": "node scripts/audit-item-catalog.mjs --write",
    "data:pokemon-facts": "node scripts/generate-pokemon-facts.mjs",
    "data:pokemon-facts:check": "node scripts/generate-pokemon-facts.mjs --check",
    "data:pokedb:environment": "node scripts/update-pokedb-environment.mjs",
    "data:pokedb:environment:check": "node scripts/update-pokedb-environment.mjs --check",
    "data:pokedb:environment:pr": "node scripts/create-pokedb-environment-refresh-pr.mjs",
    "data:pokedb:speed": "node scripts/generate-pokedb-speed-tiers.mjs",
    "data:pokedb:speed:check": "node scripts/generate-pokedb-speed-tiers.mjs --check",
    "data:vgcpastes:champions-ma": "node scripts/ingest-vgcpastes-champions.mjs --reg=ma",
    "data:vgcpastes:champions-ma:check": "node scripts/ingest-vgcpastes-champions.mjs --reg=ma --check",
    "data:vgcpastes:champions-mb": "node scripts/ingest-vgcpastes-champions.mjs --reg=mb",
    "data:vgcpastes:champions-mb:check": "node scripts/ingest-vgcpastes-champions.mjs --reg=mb --check",
    "data:vgcpastes:pr": "node scripts/create-vgcpastes-refresh-pr.mjs",
    "worker:environment:dev": "wrangler dev --config cloudflare/environment-worker/wrangler.jsonc --test-scheduled",
    "worker:environment:check": "wrangler deploy --config cloudflare/environment-worker/wrangler.jsonc --dry-run",
    "worker:environment:deploy": "wrangler deploy --config cloudflare/environment-worker/wrangler.jsonc",
    "worker:app:types": "wrangler types --config cloudflare/environment-worker/wrangler.jsonc cloudflare/environment-worker/src/worker-configuration.d.ts",
    "worker:app:dev": "npm run build && wrangler dev --config cloudflare/environment-worker/wrangler.jsonc --test-scheduled",
    "worker:app:check": "npm run build && wrangler deploy --config cloudflare/environment-worker/wrangler.jsonc --dry-run",
    "worker:app:deploy": "npm run build && wrangler deploy --config cloudflare/environment-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@smogon/calc": "^0.11.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.5",
    "wrangler": "^4.122.0"
  }
}
