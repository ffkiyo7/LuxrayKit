{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luxraykit-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "workers_dev": true,
  // 自定义域名：用 Workers Custom Domain 绑定。deploy 时 Cloudflare 会自动创建
  // 橙云代理的 DNS 记录并签发证书（无需在 Dashboard 手动建 DNS）。pattern 用裸主机名、
  // 不带 /* 和 zone_name，这是 custom_domain 的要求。
  "routes": [
    {
      "pattern": "luxraykit.com",
      "custom_domain": true
    },
    {
      "pattern": "www.luxraykit.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // PokeDB publishes once a day around 00:30 JST (15:30 UTC). Instead of probing hourly
    // (24 fixed hits/day, a recognizable bot rhythm), we cluster around that window and keep
    // a few sparse safety-net checks for drift/off-cycle updates. All times UTC.
    "crons": [
      "35 15 * * *",
      "5 16 * * *",
      "35 2,8,20 * * *"
    ]
  },
  "vars": {
    "POKEDB_BASE_URL": "https://champs.pokedb.tokyo",
    "POKEDB_DETAIL_LIMIT": "60",
    "POKEDB_DETAIL_CHUNK_SIZE": "20",
    "ENVIRONMENT_AUDIT_UNKNOWN_THRESHOLD": "0",
    "WORKER_SELF_URL": "https://luxraykit-app.ffkiyo7.workers.dev",
    "MAX_CACHE_AGE_SECONDS": "108000",
    "ALLOWED_ORIGINS": "*"
  },
  "kv_namespaces": [
    {
      "binding": "ENVIRONMENT_CACHE",
      "id": "43aafe9bdd2c4d01a980325d75eb9630",
      "preview_id": "880eb89e7fd44e7bbe582b224778b4ed"
    }
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "luxraykit-app"
    }
  ]
}
