/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'

# CSP notes (verify in production DevTools after deploy — _headers only takes effect on Cloudflare,
# never under `vite preview`, so no local test can catch a regression here):
#   script-src 'self'      — the app ships no inline <script>; index.html loads one module bundle.
#   style-src  'unsafe-inline' — React writes inline style attributes (style-src-attr falls back here).
#   font-src 'self'        — Manrope is self-hosted (src/assets/fonts, Latin subset); Chinese uses system
#     fonts. No Google Fonts origin is allowed: adding a remote @import back would silently drop the font.
#   img-src data: blob:  — catalog icons may be data: URIs; avatars fall back to generated blobs.
#   connect-src 'self'   — /api/* is served by the same Worker origin; there is no third-party call.
